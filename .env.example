# Option A: single file at repo root (loaded automatically by the API)
# SPOONACULAR_API_KEY=your_key
# Legacy CRA name also works:
# REACT_APP_API_KEY=your_key

# Option B: apps/api/.env (overrides root if both exist)
PORT=8787
SPOONACULAR_API_KEY=
# Optional: recipe copilot + smart search
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Comma-separated browser origins allowed for CORS
ALLOWED_ORIGINS=http://localhost:5173

# Web (apps/web) — optional; leave empty to use Vite dev proxy to the API
# VITE_API_BASE_URL=
