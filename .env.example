# Option A: single file at repo root (loaded automatically by the API)
# SPOONACULAR_API_KEY=your_key
# Legacy CRA name also works:
# REACT_APP_API_KEY=your_key

# Option B: apps/api/.env (overrides root if both exist)
PORT=8787
SPOONACULAR_API_KEY=
# Optional: recipe copilot + smart search (Google AI Studio → API key)
GEMINI_API_KEY=
# Aliases also accepted: GOOGLE_GENERATIVE_AI_API_KEY, GOOGLE_API_KEY
# GEMINI_MODEL=gemini-1.5-flash
# If requests fail with "fetch failed", try another model, VPN off, or HTTPS_PROXY for corporate networks.
# Comma-separated browser origins allowed for CORS
ALLOWED_ORIGINS=http://localhost:5173

# If Spoonacular / Gemini fail with DNS or "fetch failed" on a corporate network:
# HTTPS_PROXY=http://user:pass@proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1

# Web (apps/web) — optional; leave empty to use Vite dev proxy to the API
# VITE_API_BASE_URL=
